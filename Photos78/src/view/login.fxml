<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15"
      xmlns:fx="http://javafx.com/fxml">

    <padding>
        <Insets top="80" bottom="80" left="60" right="60"/>
    </padding>

    <Label text="Photos" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Label text="Enter your username to log in"
           style="-fx-font-size: 13px; -fx-text-fill: gray;"/>

    <TextField fx:id="usernameField"
               promptText="Username"
               maxWidth="250"/>

    <Button text="Log In"
            onAction="#handleLogin"
            defaultButton="true"
            maxWidth="250"
            style="-fx-font-size: 14px;"/>

    <Label fx:id="errorLabel"
           style="-fx-text-fill: red; -fx-font-size: 12px;"
           text=""/>

</VBox>